# ---------------------------------------------------------------------------
# Cloud Certification Simulator — environment variables
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Public URL of this app (no trailing slash). Used for OAuth and Stripe redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings → API). The anon key is safe in the browser;
# RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS — never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers → API keys / Webhooks). SERVER ONLY.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Days of continued access while a renewal payment is past due (0–30, default 3).
SUBSCRIPTION_GRACE_DAYS=3

# Shown on the Contact and legal pages.
NEXT_PUBLIC_CONTACT_EMAIL=support@example.com

# Local Supabase only (supabase/config.toml reads these when the providers are enabled).
# Hosted Supabase: set the Google/GitHub client ID + secret in the dashboard instead.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
